# slm-lab — Environment Variables
# Copy to .env and fill in. .env is gitignored and never committed.

# Anthropic API — used ONLY in Track B Phase 2 (gold-label generation / distillation
# teacher) and Phase 4 (Claude-as-judge eval). Not needed for Track A.
ANTHROPIC_API_KEY=

# Optional: HuggingFace token — only needed if a base model is gated.
# Qwen3 and Gemma 4 are open; you likely won't need this.
HF_TOKEN=
